{
  "name": "reelcoach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node .server-dist/server/index.js",
    "preview": "vite preview",
    "test": "vitest run src server api",
    "test:e2e": "playwright test",
    "test:watch": "vitest src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.10.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "prettier": "^3.10.0",
    "vitest": "^5.1.0"
  }
}
