# Never paste real credentials into chat or commit a populated .env file.
# This project uses Meta's CURRENT Unified Login (not the legacy Instagram App ID/Secret).

# BOTH Vercel and the always-on backend: exact canonical frontend origin, no trailing path.
APP_ORIGIN=https://reelcoach.vercel.app

# VERCEL ONLY: HTTPS root of your separately hosted single-process backend.
AUTH_BACKEND_ORIGIN=https://your-private-backend.example

# BOTH HOSTS: identical, randomly generated 32+ character shared proxy credential.
# Generate privately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_BACKEND_PROXY_SECRET=

# RAM BACKEND ONLY: Meta app > App settings > Basic (NOT Instagram-specific legacy IDs).
META_APP_ID=
META_APP_SECRET=

# RAM BACKEND ONLY: Use cases > Manage messaging & content on Instagram > Customize
# > API setup with Unified login > Configure your app > compatible configuration ID.
META_CONFIG_ID=

# RAM BACKEND ONLY: separate random 32+ character value for Meta webhook verification.
# Register the verification URL only; DO NOT subscribe to messages or other webhook fields.
META_WEBHOOK_VERIFY_TOKEN=

# RAM BACKEND ONLY: fixed maximum app-session lifetime (300–3600 seconds; default 45 min).
SESSION_TTL_SECONDS=2700
PORT=8080
NODE_ENV=production

# LOCAL DEVELOPMENT ONLY (not Vercel): Vite forwards API requests to this address.
# Set APP_ORIGIN=http://localhost:5173 and NODE_ENV=development locally.
DEV_AUTH_BACKEND_ORIGIN=http://127.0.0.1:8080

# There are intentionally NO VITE_* credentials, database URLs, or saved access tokens.
